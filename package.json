{
  "name": "the-sweep",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Invite-only 2026 international football sweepstake",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atk0309/the-sweep.git"
  },
  "bugs": {
    "url": "https://github.com/atk0309/the-sweep/issues"
  },
  "homepage": "https://github.com/atk0309/the-sweep#readme",
  "keywords": [
    "football",
    "sweepstake",
    "node",
    "postgresql"
  ],
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev": "node --env-file-if-exists=.env --watch server/index.js",
    "test": "node --test scripts/auth_runtime.test.mjs && node scripts/throttle.test.mjs",
    "check": "node scripts/check.mjs && npm test",
    "smoke": "node scripts/smoke.mjs",
    "e2e": "node scripts/e2e.mjs",
    "integration:poller": "node scripts/poller_test.mjs",
    "integration:live": "node scripts/live_ingest.mjs",
    "gen:teams": "node scripts/gen-teams.mjs"
  },
  "dependencies": {
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.5",
    "resend": "^6.18.0"
  },
  "devDependencies": {
    "playwright": "^1.61.1"
  }
}

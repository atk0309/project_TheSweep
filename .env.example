# Copy this file to .env for local development.
NODE_ENV=development
# This opt-in unlocks deliberately insecure local-only defaults. Never set it
# on an internet-facing deployment.
ALLOW_INSECURE_DEVELOPMENT=1
PORT=3999

# Local Docker example:
DATABASE_URL=postgres://sweep:sweep@localhost:5432/sweep
# Remote TLS verification is enabled by default. Do not disable it casually.
DATABASE_SSL_REJECT_UNAUTHORIZED=1

# Generate a production value with: openssl rand -hex 32
SESSION_SECRET=
APP_URL=http://localhost:3999

# In development, leaving RESEND_API_KEY empty prints the one-time link locally.
RESEND_API_KEY=
EMAIL_FROM="The Sweep <noreply@example.com>"
ADMIN_EMAILS=admin@example.com

# Optional match data.
FOOTBALL_API_KEY=
FOOTBALL_API_BASE=https://v3.football.api-sports.io
POLLER_DISABLED=1

# Third-party content is opt-in. Guardian developer keys are non-commercial.
NEWS_ENABLED=0
COMMENTARY_ENABLED=0
GUARDIAN_API_KEY=
GUARDIAN_DAILY_BUDGET=500
GUARDIAN_NEWS_RESERVE=200

# Abuse controls and game setup.
SEND_CAP_HOUR=100
SEND_CAP_DAY=500
MIN_DRAW_PLAYERS=2
